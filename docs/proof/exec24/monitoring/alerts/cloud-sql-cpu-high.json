{
  "displayName": "OpenStaff Prod - Cloud SQL CPU High",
  "combiner": "OR",
  "enabled": true,
  "notificationChannels": [
    "projects/openstaff-platform/notificationChannels/16914670128256150084"
  ],
  "documentation": {
    "mimeType": "text/markdown",
    "content": "Severity: SEV-2\nOwner: Technical Ops\nThreshold: Cloud SQL CPU utilization above 80% for 10 minutes.\nExpected response: acknowledge within 15 minutes and inspect query pressure, app latency, and instance saturation."
  },
  "conditions": [
    {
      "displayName": "cpu utilization > 80% for 10m",
      "conditionThreshold": {
        "filter": "resource.type=\"cloudsql_database\" AND metric.type=\"cloudsql.googleapis.com/database/cpu/utilization\" AND resource.labels.database_id=\"openstaff-platform:openstaff-db\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.8,
        "duration": "600s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_MEAN"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ]
}
