  insuranceTerms  String?
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
