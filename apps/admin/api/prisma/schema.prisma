generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id       String @id @default(uuid())
  name     String
  code     String @unique
  currency String
  vatRate  Float

  regions                    Region[]
  projects                   Project[]
  profiles                   Profile[]
  publicPosts                PublicPost[]
  taxRules                   TaxRule[]
  contractFinancialSnapshots ContractFinancialSnapshot[]
}

model Region {
  id        String @id @default(uuid())
  name      String
  countryId String

  country     Country      @relation(fields: [countryId], references: [id])
  cities      City[]
  projects    Project[]
  profiles    Profile[]
  publicPosts PublicPost[]

  @@index([countryId])
}

model City {
  id       String @id @default(uuid())
  name     String
  regionId String

  region      Region       @relation(fields: [regionId], references: [id])
  projects    Project[]
  profiles    Profile[]
  publicPosts PublicPost[]

  @@index([regionId])
}

model Language {
  id   String @id @default(uuid())
  code String @unique
  name String

  projects    Project[]
  jobRequests ProjectJobRequest[]
  profiles    ProfileLanguage[]
}

model Uniclass {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  description String?

  projects    ProjectUniclassClassification[]
  jobRequests ProjectJobRequestUniclassClassification[]
  profiles    ProfileUniclassClassification[]
}

model EscoSkill {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  description String?

  projects       ProjectEscoClassification[]
  jobRequests    ProjectJobRequestEscoClassification[]
  profiles       ProfileEscoClassification[]
  certifications ActorCertification[]
  workerSkills   WorkerSkill[]
}

model Nace {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  description String?

  projects    ProjectNaceClassification[]
  jobRequests ProjectJobRequestNaceClassification[]
  profiles    ProfileNaceClassification[]
}

model User {
  id               String                 @id @default(uuid())
  email            String                 @unique
  firebaseUid      String?                @unique
  password         String
  refreshTokenHash String?
  role             Role
  approvalStatus   AccountApprovalStatus  @default(PENDING)
  accountStatus    AccountLifecycleStatus @default(OFFLINE)
  approvedAt       DateTime?
  approvedById     String?
  suspendedAt      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime               @default(now())

  profile                            Profile?
  publicPosts                        PublicPost[]
  projects                           Project[]                    @relation("ProjectCreatedBy")
  uploadedProjectDocuments           ProjectDocument[]            @relation("ProjectDocumentUploadedBy")
  reviewedAiInterpretations          ProjectAIInterpretation[]    @relation("ProjectAIReviewedBy")
  uploadedProfileDocuments           ProfileDocument[]            @relation("ProfileDocumentUploadedBy")
  createdShortlists                  ProjectShortlist[]           @relation("ProjectShortlistCreatedBy")
  createdInvitations                 ProjectInvitation[]          @relation("ProjectInvitationCreatedBy")
  submittedProposals                 ProjectProposal[]            @relation("ProjectProposalSubmittedBy")
  createdContracts                   ProjectContract[]            @relation("ProjectContractCreatedBy")
  issuedProjectInvoices              ProjectInvoice[]             @relation("ProjectInvoiceIssuedBy")
  openedProjectDisputes              ProjectDispute[]             @relation("ProjectDisputeOpenedBy")
  projectDisputeEvents               ProjectDisputeEvent[]        @relation("ProjectDisputeEventActor")
  actorDocuments                     ActorDocument[]              @relation("ActorDocumentOwner")
  verifiedActorDocuments             ActorDocument[]              @relation("ActorDocumentVerifiedBy")
  actorCertifications                ActorCertification[]         @relation("ActorCertificationOwner")
  verifiedActorCertifications        ActorCertification[]         @relation("ActorCertificationVerifiedBy")
  medicalFitnessCertificates         MedicalFitnessCertificate[]  @relation("MedicalFitnessOwner")
  verifiedMedicalFitnessCertificates MedicalFitnessCertificate[]  @relation("MedicalFitnessVerifiedBy")
  complianceAlerts                   ComplianceAlert[]
  assignedTasks                      UserTask[]                   @relation("UserTaskAssignedTo")
  auditLogs                          AuditLog[]                   @relation("AuditLogActorUser")
  targetedAuditLogs                  AuditLog[]                   @relation("AuditLogTargetUser")
  securityEvents                     SecurityEvent[]              @relation("SecurityEventUser")
  reviewedSecurityEvents             SecurityEvent[]              @relation("SecurityEventReviewedBy")
  userSessions                       UserSession[]
  userDeviceFingerprints             UserDeviceFingerprint[]
  complianceRequests                 ComplianceRequest[]          @relation("ComplianceRequestUser")
  reviewedComplianceRequests         ComplianceRequest[]          @relation("ComplianceRequestReviewedBy")
  notifications                      Notification[]
  notificationEvents                 NotificationEvent[]          @relation("NotificationEventUser")
  notificationDeliveries             NotificationDelivery[]       @relation("NotificationDeliveryUser")
  notificationPreferences            NotificationPreference?
  triggeredWorkflowAutomationRuns    WorkflowAutomationRun[]      @relation("WorkflowAutomationRunTriggeredBy")
  reviewedWorkflowAutomationRuns     WorkflowAutomationRun[]      @relation("WorkflowAutomationRunReviewedBy")
  subscriptions                      AccountSubscription[]
  usageMeters                        UsageMeter[]
  upgradeRequests                    SubscriptionUpgradeRequest[]
  billingProfile                     BillingProfile?
  billingEvents                      BillingEvent[]
  billingInvoices                    BillingInvoice[]
  paymentRecords                     PaymentRecord[]
  subscriptionRenewals               SubscriptionRenewal[]
  identityProfile                    IdentityProfile?
  identityCompanyProfiles            IdentityCompanyProfile[]
  onboardingSession                  OnboardingSession?
  twoFactorSettings                  UserTwoFactorSettings?
  twoFactorChallenges                UserTwoFactorChallenge[]
  verificationCases                  VerificationCase[]
  reviewedVerificationCases          VerificationCase[]             @relation("VerificationCaseReviewedBy")
  verificationDecisions              VerificationDecision[]         @relation("VerificationDecisionActorUser")
  candidateApplications              Application[]                 @relation("ApplicationCandidateUser")
  applicationStageChanges            ApplicationStageHistory[]     @relation("ApplicationStageHistoryChangedBy")
  hiringDecisions                    HiringDecision[]              @relation("HiringDecisionDecidedBy")
  workforceAssignments               WorkforceAssignment[]
  contractLifecycleEvents            ContractLifecycleEvent[]      @relation("ContractLifecycleEventActorUser")
  operationalTimesheets             Timesheet[]
  approvedOperationalTimesheets     Timesheet[]                   @relation("TimesheetApprovedBy")
  attendanceRecords                 AttendanceRecord[]
  payrollSettlements                PayrollSettlement[]
  approvedPayrollSettlements        PayrollSettlement[]           @relation("PayrollSettlementApprovedBy")
  profileWorkers                     ProfileWorker[]              @relation("ProfileWorkerLinkedUser")
  assignedWorkerAssignments          ProjectWorkerAssignment[]    @relation("ProjectWorkerAssignmentAssignedBy")
  approvedWorkerAssignments          ProjectWorkerAssignment[]    @relation("ProjectWorkerAssignmentApprovedBy")
  approvedWorkerTimesheets           WorkerTimesheet[]            @relation("WorkerTimesheetApprovedBy")
  taxonomyImportBatches              TaxonomyImportBatch[]
  reluTasks                          ReluTask[]
  reluProcessingRunsAsSubject        ReluProcessingRun[]          @relation("ReluProcessingRunUser")
  reluTriggeredProcessingRuns        ReluProcessingRun[]          @relation("ReluProcessingRunTriggeredBy")
  reluClassificationResults          ReluClassificationResult[]   @relation("ReluClassificationUser")
  reluReviewedClassificationResults  ReluClassificationResult[]   @relation("ReluClassificationReviewedBy")
  reluMatchResults                   ReluMatchResult[]            @relation("ReluMatchUser")
  reluReviewedMatchResults           ReluMatchResult[]            @relation("ReluMatchReviewedBy")
  reluRecommendations                ReluRecommendation[]         @relation("ReluRecommendationUser")
  reluReviewedRecommendations        ReluRecommendation[]         @relation("ReluRecommendationReviewedBy")
  conversationParticipants           ConversationParticipant[]
  removedConversationParticipants    ConversationParticipant[]    @relation("ConversationParticipantRemovedBy")
  sentMessages                       Message[]                    @relation("MessageSender")
  deletedMessages                    Message[]                    @relation("MessageDeletedBy")
  moderatedMessages                  Message[]                    @relation("MessageModeratedBy")
  messageReads                       MessageRead[]
  uploadedMessageAttachments         MessageAttachment[]          @relation("MessageAttachmentUploadedBy")
  moderatedMessageAttachments        MessageAttachment[]          @relation("MessageAttachmentModeratedBy")
}

model IdentityProfile {
  id                       String             @id @default(uuid())
  userId                   String             @unique
  publicSlug               String             @unique
  firstName                String?
  lastName                 String?
  displayName              String
  avatarUrl                String?
  bio                      String?
  language                 String?
  timezone                 String?
  country                  String?
  city                     String?
  phone                    String?
  website                  String?
  linkedinUrl              String?
  githubUrl                String?
  portfolioUrl             String?
  verificationStatus       VerificationStatus @default(UNVERIFIED)
  onboardingCompletedAt    DateTime?
  profileCompletionPercent Int                @default(0)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationCases  VerificationCase[]

  @@index([verificationStatus, createdAt])
  @@index([profileCompletionPercent])
}

model IdentityCompanyProfile {
  id                    String             @id @default(uuid())
  ownerUserId           String
  companyName           String
  legalName             String?
  registrationNumber    String?
  vatId                 String?
  country               String?
  city                  String?
  addressLine1          String?
  addressLine2          String?
  postalCode            String?
  website               String?
  logoUrl               String?
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  onboardingCompletedAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  ownerUser          User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  verificationCases  VerificationCase[]

  @@index([ownerUserId, createdAt])
  @@index([verificationStatus, createdAt])
}

model OnboardingSession {
  id                String           @id @default(uuid())
  userId            String           @unique
  currentStep       String           @default("welcome")
  completedSteps    Json?
  completionPercent Int              @default(0)
  status            OnboardingStatus @default(NOT_STARTED)
  startedAt         DateTime         @default(now())
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, completionPercent])
}

model VerificationCase {
  id                String                      @id @default(uuid())
  userId            String
  subjectType       VerificationCaseSubjectType
  identityProfileId String?
  companyProfileId  String?
  status            VerificationCaseStatus     @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  latestNote        String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityProfile IdentityProfile?       @relation(fields: [identityProfileId], references: [id], onDelete: Cascade)
  companyProfile  IdentityCompanyProfile? @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  reviewedBy      User?                  @relation("VerificationCaseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  documentLinks   VerificationCaseDocument[]
  decisions       VerificationDecision[]

  @@index([userId, subjectType, status])
  @@index([identityProfileId, status])
  @@index([companyProfileId, status])
  @@index([reviewedById, reviewedAt])
}

model VerificationCaseDocument {
  id                          String                @id @default(uuid())
  verificationCaseId          String
  assetType                   VerificationAssetType
  profileDocumentId           String?
  actorDocumentId             String?
  actorCertificationId        String?
  medicalFitnessCertificateId String?
  label                       String?
  createdAt                   DateTime              @default(now())

  verificationCase          VerificationCase          @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)
  profileDocument           ProfileDocument?          @relation(fields: [profileDocumentId], references: [id], onDelete: SetNull)
  actorDocument             ActorDocument?            @relation(fields: [actorDocumentId], references: [id], onDelete: SetNull)
  actorCertification        ActorCertification?       @relation(fields: [actorCertificationId], references: [id], onDelete: SetNull)
  medicalFitnessCertificate MedicalFitnessCertificate? @relation(fields: [medicalFitnessCertificateId], references: [id], onDelete: SetNull)

  @@index([verificationCaseId, assetType])
  @@index([profileDocumentId])
  @@index([actorDocumentId])
  @@index([actorCertificationId])
  @@index([medicalFitnessCertificateId])
}

model VerificationDecision {
  id                 String                 @id @default(uuid())
  verificationCaseId String
  actorUserId        String?
  decision           VerificationDecisionType
  fromStatus         VerificationCaseStatus?
  toStatus           VerificationCaseStatus
  note               String?
  createdAt          DateTime               @default(now())

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)
  actorUser        User?            @relation("VerificationDecisionActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([verificationCaseId, createdAt])
  @@index([actorUserId, createdAt])
}

model SubscriptionPlan {
  id           String                 @id @default(uuid())
  code         SubscriptionPlanCode   @unique
  name         String
  description  String?
  status       SubscriptionPlanStatus @default(ACTIVE)
  displayOrder Int                    @default(0)
  currencyCode String                 @default("EUR")
  priceMonthly Int                    @default(0)
  priceYearly  Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  entitlements  PlanEntitlement[]
  subscriptions AccountSubscription[]

  @@index([status, displayOrder])
}

model PlanEntitlement {
  id         String   @id @default(uuid())
  planId     String
  featureKey String
  enabled    Boolean  @default(true)
  limitInt   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([featureKey])
}

model AccountSubscription {
  id         String                    @id @default(uuid())
  userId     String
  planId     String
  status     AccountSubscriptionStatus @default(ACTIVE)
  startedAt  DateTime                  @default(now())
  expiresAt  DateTime?
  canceledAt DateTime?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  usageMeters     UsageMeter[]
  billingEvents   BillingEvent[]
  billingInvoices BillingInvoice[]
  renewals        SubscriptionRenewal[]

  @@index([userId, status, startedAt])
  @@index([planId, status])
}

model BillingEvent {
  id             String             @id @default(uuid())
  createdAt      DateTime           @default(now())
  userId         String
  subscriptionId String?
  type           BillingEventType
  amount         Int
  currency       String             @default("EUR")
  status         BillingEventStatus @default(PENDING)
  description    String
  metadata       Json?

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription AccountSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceLine  BillingInvoiceLine?
  billingLink  WorkforceBillingLink?

  @@index([userId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([type, status, createdAt])
}

model BillingProfile {
  id           String         @id @default(uuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userId       String         @unique
  companyName  String?
  vatId        String?
  country      String
  region       String?
  city         String?
  addressLine1 String
  addressLine2 String?
  postalCode   String?
  currency     String         @default("EUR")
  isCompany    Boolean        @default(false)
  isVatPayer   Boolean        @default(false)
  vatMode      BillingVatMode @default(DOMESTIC)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([country, vatMode])
}

model BillingInvoice {
  id                String               @id @default(uuid())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  userId            String
  subscriptionId    String?
  invoiceNumber     String               @unique
  invoiceType       BillingInvoiceType   @default(PROFORMA)
  status            BillingInvoiceStatus @default(DRAFT)
  currency          String               @default("EUR")
  fiscalSeries      String?
  fiscalNumber      String?
  proformaReference String?
  subtotal          Decimal              @db.Decimal(10, 2)
  taxAmount         Decimal              @default(0) @db.Decimal(10, 2)
  total             Decimal              @db.Decimal(10, 2)
  issuedAt          DateTime
  dueAt             DateTime
  paidAt            DateTime?
  metadata          Json?

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription AccountSubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  lines        BillingInvoiceLine[]
  payments     PaymentRecord[]
  renewals     SubscriptionRenewal[]
  workforceBillingLinks WorkforceBillingLink[]

  @@index([userId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([status, issuedAt])
}

model BillingInvoiceLine {
  id             String  @id @default(uuid())
  invoiceId      String
  billingEventId String? @unique
  description    String
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(10, 2)
  amount         Decimal @db.Decimal(10, 2)
  metadata       Json?

  invoice      BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  billingEvent BillingEvent?  @relation(fields: [billingEventId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model PaymentRecord {
  id                String              @id @default(uuid())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  userId            String
  invoiceId         String?
  provider          PaymentProvider
  providerPaymentId String?
  status            PaymentRecordStatus @default(PENDING)
  amount            Decimal             @db.Decimal(10, 2)
  currency          String              @default("EUR")
  paidAt            DateTime?
  metadata          Json?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([invoiceId, createdAt])
  @@index([provider, status, createdAt])
}

model BillingWebhookEvent {
  id          String               @id @default(uuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  provider    String
  eventType   String
  externalId  String?
  status      BillingWebhookStatus @default(RECEIVED)
  payload     Json
  error       String?
  processedAt DateTime?

  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@index([externalId])
}

model SubscriptionRenewal {
  id               String                    @id @default(uuid())
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  subscriptionId   String
  userId           String
  status           SubscriptionRenewalStatus @default(SCHEDULED)
  periodStart      DateTime
  periodEnd        DateTime
  scheduledAt      DateTime
  processedAt      DateTime?
  billingInvoiceId String?
  metadata         Json?

  subscription   AccountSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingInvoice BillingInvoice?     @relation(fields: [billingInvoiceId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, periodStart, periodEnd])
  @@index([userId, createdAt])
  @@index([status, scheduledAt])
}

model UsageMeter {
  id             String    @id @default(uuid())
  userId         String
  subscriptionId String?
  metricKey      String
  used           Int       @default(0)
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription AccountSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([userId, metricKey])
  @@index([subscriptionId])
}

model SubscriptionUpgradeRequest {
  id                String   @id @default(uuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String?
  currentPlanCode   String?
  requestedPlanCode String
  name              String?
  email             String
  companyName       String?
  phone             String?
  message           String?  @db.Text
  source            String   @default("PRICING")
  status            String   @default("PENDING")
  metadata          Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([requestedPlanCode, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("subscription_upgrade_requests")
}

model RolePermission {
  id         String     @id @default(uuid())
  role       Role
  permission Permission
  enabled    Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([role, permission])
  @@index([role, enabled])
}

model UiConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  header    Json
  homepage  Json
  footer    Json
  branding  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaxonomySourceDocumentRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  source    String
  locale    String
  format    String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, locale])
}

model TaxonomyIndustryRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  slug      String   @unique
  name      String
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([source])
}

model TaxonomyCategoryRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  slug         String   @unique
  name         String
  industrySlug String
  source       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([industrySlug, slug])
  @@index([source])
}

model TaxonomyCertificationRecord {
  id          String   @id @default(uuid())
  code        String   @unique
  slug        String   @unique
  name        String
  issuer      String?
  category    String?
  description String?
  source      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, name])
  @@index([source])
}

model TaxonomyImportBatch {
  id                    String                   @id @default(uuid())
  entityType            TaxonomyImportEntityType
  status                TaxonomyImportStatus     @default(UPLOADED)
  fileName              String
  fileMimeType          String
  storageKey            String
  createdById           String?
  rowCount              Int                      @default(0)
  previewJson           Json?
  errorsJson            Json?
  duplicateSummaryJson  Json?
  parsedRowsJson        Json?
  validationSummaryJson Json?
  commitSummaryJson     Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  committedAt           DateTime?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([entityType, createdAt])
  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

model TaxonomyProfessionRecord {
  id               String   @id @default(uuid())
  key              String   @unique
  slug             String   @unique
  name             String
  industrySlug     String
  categorySlug     String
  source           String
  labelsJson       Json
  descriptionsJson Json
  tagsJson         Json
  skillsJson       Json
  mappingsJson     Json
  referencesJson   Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([industrySlug, categorySlug])
  @@index([source])
}

model PublicPost {
  id                    String                 @id @default(uuid())
  slug                  String                 @unique
  authorUserId          String?
  authorProfileId       String?
  type                  PublicPostType
  title                 String
  description           String
  domain                String
  location              String
  status                String
  moderationStatus      PublicModerationStatus @default(PENDING)
  bannerUrl             String?
  summary               String?
  experienceLabel       String?
  value                 String
  currencyCode          String?
  vatRate               Float?
  fiscalMetadataJson    Json?
  budgetMin             Float?
  budgetMax             Float?
  salaryMin             Float?
  salaryMax             Float?
  certificationsOffered String?
  ownerName             String
  ownerType             String
  classificationJson    Json
  escoCodesJson         String?
  naceCodesJson         String?
  uniclassCodesJson     String?
  languageCodesJson     String?
  documentsJson         String?
  countryId             String?
  regionId              String?
  cityId                String?
  certifications        String
  visibility            PublicPostVisibility   @default(PUBLIC)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  authorUser           User?                    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorProfile        Profile?                 @relation(fields: [authorProfileId], references: [id], onDelete: SetNull)
  country              Country?                 @relation(fields: [countryId], references: [id])
  region               Region?                  @relation(fields: [regionId], references: [id])
  city                 City?                    @relation(fields: [cityId], references: [id])
  media                PublicPostMedia[]
  documents            PublicPostDocument[]
  externalLinks        ExternalLinkSubmission[]
  privateConversations PrivateConversation[]
  conversations        Conversation[]
  comments             PublicComment[]
  reviews              PublicReview[]

  @@index([type, visibility, createdAt])
  @@index([status, moderationStatus, createdAt])
  @@index([authorUserId, createdAt])
  @@index([authorProfileId, createdAt])
  @@index([countryId, regionId, cityId])
}

model PublicPostMedia {
  id        String                 @id @default(uuid())
  postId    String
  url       String
  type      PublicPostMediaType
  role      String                 @default("GALLERY")
  alt       String?
  status    PublicModerationStatus @default(PENDING)
  createdAt DateTime               @default(now())
