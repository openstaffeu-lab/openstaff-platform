model ProjectWorkerAssignment {
  id           String                        @id @default(uuid())
  projectId    String
  contractId   String?
  jobRequestId String?
  profileId    String
  workerId     String
  status       ProjectWorkerAssignmentStatus @default(PROPOSED)
  assignedById String
  approvedById String?
  assignedAt   DateTime                      @default(now())
  approvedAt   DateTime?
  removedAt    DateTime?

  project      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract     ProjectContract?              @relation(fields: [contractId], references: [id], onDelete: SetNull)
  jobRequest   ProjectJobRequest?            @relation(fields: [jobRequestId], references: [id], onDelete: SetNull)
  profile      Profile                       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  worker       ProfileWorker                 @relation(fields: [workerId], references: [id], onDelete: Cascade)
  assignedBy   User                          @relation("ProjectWorkerAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  approvedBy   User?                         @relation("ProjectWorkerAssignmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  attendances  WorkerAttendance[]
  workLogs     WorkerWorkLog[]

  @@index([projectId, status, assignedAt])
  @@index([contractId, status])
  @@index([jobRequestId, status])
  @@index([profileId, status])
  @@index([workerId, status])
  @@index([assignedById, assignedAt])
  @@index([approvedById, approvedAt])
}

model WorkerAttendance {
  id            String                 @id @default(uuid())
  projectId     String
  contractId    String?
  jobRequestId  String?
