  nrAngajati            Int?
  experientaSimilara    String?     @db.Text
  statusFirma           FirmaStatus @default(ACTIVA)
  contBancar            String?
  adresa                String?
  obiectActivitate      String[]
  experientaMunca       Int?
  cazierUrl             String?
  adeverintaMedicalaUrl String?
  certificariUrls       String[]
  serviciiIds           String[]
