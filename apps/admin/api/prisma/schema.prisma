  @@index([invoiceId, status, createdAt])
  @@index([escrowAccountId, status, createdAt])
  @@index([profileId, status, createdAt])
}

model ProjectDispute {
  id               String                 @id @default(uuid())
  projectId        String
  contractId       String
  milestoneId      String?
  invoiceId        String?
  paymentId        String?
  openedById       String
  againstProfileId String?
  type             ProjectDisputeType
  status           ProjectDisputeStatus   @default(OPEN)
  severity         ProjectDisputeSeverity @default(MEDIUM)
  title            String
  description      String
  resolutionNotes  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  resolvedAt       DateTime?

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract         ProjectContract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone        ProjectMilestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  invoice          ProjectInvoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
