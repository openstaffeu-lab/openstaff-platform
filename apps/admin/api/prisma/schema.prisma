  lastName       String
  email          String?
  phone          String?
  roleTitle      String
  employmentType WorkerEmploymentType
  status         WorkerStatus         @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  profile        Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
