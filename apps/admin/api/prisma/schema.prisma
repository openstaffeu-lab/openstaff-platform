  @@index([contractId, status, createdAt])
  @@index([milestoneId, status])
  @@index([invoiceId, status])
  @@index([paymentId, status])
  @@index([openedById, createdAt])
  @@index([againstProfileId, status])
}

model ProjectDisputeEvent {
