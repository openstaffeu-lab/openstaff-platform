  worker                          ProfileWorker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([contractId, createdAt])
  @@index([profileId, createdAt])
  @@index([workerId, createdAt])
}

