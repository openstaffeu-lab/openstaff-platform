generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id       String   @id @default(uuid())
  name     String
  code     String   @unique
  currency String
  vatRate  Float

  regions                    Region[]
  projects                   Project[]
  profiles                   Profile[]
  publicPosts                PublicPost[]
  taxRules                   TaxRule[]
  contractFinancialSnapshots ContractFinancialSnapshot[]
}

model Region {
  id        String   @id @default(uuid())
  name      String
  countryId String

  country   Country  @relation(fields: [countryId], references: [id])
  cities    City[]
  projects  Project[]
  profiles  Profile[]
  publicPosts PublicPost[]

  @@index([countryId])
}

model City {
  id       String   @id @default(uuid())
  name     String
  regionId String

  region   Region    @relation(fields: [regionId], references: [id])
  projects Project[]
  profiles Profile[]
  publicPosts PublicPost[]

  @@index([regionId])
}

model Language {
  id          String              @id @default(uuid())
  code        String              @unique
  name        String

  projects    Project[]
  jobRequests ProjectJobRequest[]
  profiles    ProfileLanguage[]
}

model Uniclass {
  id          String @id @default(uuid())
  code        String @unique
  title       String
  description String?

  projects    ProjectUniclassClassification[]
  jobRequests ProjectJobRequestUniclassClassification[]
  profiles    ProfileUniclassClassification[]
}

model EscoSkill {
  id          String @id @default(uuid())
  code        String @unique
  title       String
  description String?

  projects    ProjectEscoClassification[]
  jobRequests ProjectJobRequestEscoClassification[]
  profiles    ProfileEscoClassification[]
  certifications ActorCertification[]
  workerSkills WorkerSkill[]
}

model Nace {
  id          String @id @default(uuid())
  code        String @unique
  title       String
  description String?

  projects    ProjectNaceClassification[]
  jobRequests ProjectJobRequestNaceClassification[]
  profiles    ProfileNaceClassification[]
}

model User {
  id                        String                    @id @default(uuid())
  email                     String                    @unique
  password                  String
  role                      Role
  approvalStatus            AccountApprovalStatus     @default(PENDING)
  accountStatus             AccountLifecycleStatus    @default(OFFLINE)
  approvedAt                DateTime?
  approvedById              String?
  suspendedAt               DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime                  @default(now())

  profile                   Profile?
  publicPosts               PublicPost[]
  projects                  Project[]                 @relation("ProjectCreatedBy")
  uploadedProjectDocuments  ProjectDocument[]         @relation("ProjectDocumentUploadedBy")
  reviewedAiInterpretations ProjectAIInterpretation[] @relation("ProjectAIReviewedBy")
  uploadedProfileDocuments  ProfileDocument[]         @relation("ProfileDocumentUploadedBy")
  createdShortlists         ProjectShortlist[]        @relation("ProjectShortlistCreatedBy")
  createdInvitations        ProjectInvitation[]       @relation("ProjectInvitationCreatedBy")
  submittedProposals        ProjectProposal[]         @relation("ProjectProposalSubmittedBy")
  createdContracts          ProjectContract[]         @relation("ProjectContractCreatedBy")
  issuedProjectInvoices     ProjectInvoice[]          @relation("ProjectInvoiceIssuedBy")
  openedProjectDisputes     ProjectDispute[]          @relation("ProjectDisputeOpenedBy")
  projectDisputeEvents      ProjectDisputeEvent[]     @relation("ProjectDisputeEventActor")
  actorDocuments            ActorDocument[]           @relation("ActorDocumentOwner")
  verifiedActorDocuments    ActorDocument[]           @relation("ActorDocumentVerifiedBy")
  actorCertifications       ActorCertification[]      @relation("ActorCertificationOwner")
  verifiedActorCertifications ActorCertification[]    @relation("ActorCertificationVerifiedBy")
  medicalFitnessCertificates MedicalFitnessCertificate[] @relation("MedicalFitnessOwner")
  verifiedMedicalFitnessCertificates MedicalFitnessCertificate[] @relation("MedicalFitnessVerifiedBy")
  complianceAlerts          ComplianceAlert[]
  assignedTasks             UserTask[]                @relation("UserTaskAssignedTo")
  auditLogs                 AuditLog[]                @relation("AuditLogActorUser")
  notifications             Notification[]
  profileWorkers            ProfileWorker[]           @relation("ProfileWorkerLinkedUser")
  assignedWorkerAssignments ProjectWorkerAssignment[] @relation("ProjectWorkerAssignmentAssignedBy")
  approvedWorkerAssignments ProjectWorkerAssignment[] @relation("ProjectWorkerAssignmentApprovedBy")
  approvedWorkerTimesheets  WorkerTimesheet[]         @relation("WorkerTimesheetApprovedBy")
  taxonomyImportBatches     TaxonomyImportBatch[]
  reluTasks                 ReluTask[]
  conversationParticipants  ConversationParticipant[]
  sentMessages              Message[]                 @relation("MessageSender")
  messageReads              MessageRead[]
}

model RolePermission {
  id         String      @id @default(uuid())
  role       Role
  permission Permission
  enabled    Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([role, permission])
  @@index([role, enabled])
}

model UiConfig {
  id         String   @id @default(uuid())
  key        String   @unique
  header     Json
  homepage   Json
  footer     Json
  branding   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TaxonomySourceDocumentRecord {
  id         String   @id @default(uuid())
  key        String   @unique
  name       String
  source     String
  locale     String
  format     String
  note       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([source, locale])
}

model TaxonomyIndustryRecord {
  id         String   @id @default(uuid())
  key        String   @unique
  slug       String   @unique
  name       String
  source     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([slug])
  @@index([source])
}

model TaxonomyCategoryRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  slug         String   @unique
  name         String
  industrySlug String
  source       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([industrySlug, slug])
  @@index([source])
}

model TaxonomyCertificationRecord {
  id          String   @id @default(uuid())
  code        String   @unique
  slug        String   @unique
  name        String
  issuer      String?
  category    String?
  description String?
  source      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, name])
  @@index([source])
}

model TaxonomyImportBatch {
  id                    String                   @id @default(uuid())
  entityType            TaxonomyImportEntityType
  status                TaxonomyImportStatus    @default(UPLOADED)
  fileName              String
  fileMimeType          String
  storageKey            String
  createdById           String?
  rowCount              Int                      @default(0)
  previewJson           Json?
  errorsJson            Json?
  duplicateSummaryJson  Json?
  parsedRowsJson        Json?
  validationSummaryJson Json?
  commitSummaryJson     Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  committedAt           DateTime?

  createdBy             User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([entityType, createdAt])
  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

model TaxonomyProfessionRecord {
  id               String   @id @default(uuid())
  key              String   @unique
  slug             String   @unique
  name             String
  industrySlug     String
  categorySlug     String
  source           String
  labelsJson       Json
  descriptionsJson Json
  tagsJson         Json
  skillsJson       Json
  mappingsJson     Json
  referencesJson   Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([industrySlug, categorySlug])
  @@index([source])
}

model PublicPost {
  id                 String                @id @default(uuid())
  slug               String                @unique
  authorUserId       String?
  authorProfileId    String?
  type               PublicPostType
  title              String
  description        String
  domain             String
  location           String
  status             String
  moderationStatus   PublicModerationStatus @default(PENDING)
  bannerUrl          String?
  summary            String?
  experienceLabel    String?
  value              String
  currencyCode       String?
  vatRate            Float?
  fiscalMetadataJson Json?
  budgetMin          Float?
  budgetMax          Float?
  salaryMin          Float?
  salaryMax          Float?
  certificationsOffered String?
  ownerName          String
  ownerType          String
  classificationJson Json
  escoCodesJson      String?
  naceCodesJson      String?
  uniclassCodesJson  String?
  languageCodesJson  String?
  documentsJson      String?
  countryId          String?
  regionId           String?
  cityId             String?
  certifications     String
  visibility         PublicPostVisibility  @default(PUBLIC)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  authorUser         User?                 @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorProfile      Profile?              @relation(fields: [authorProfileId], references: [id], onDelete: SetNull)
  country            Country?              @relation(fields: [countryId], references: [id])
  region             Region?               @relation(fields: [regionId], references: [id])
  city               City?                 @relation(fields: [cityId], references: [id])
  media              PublicPostMedia[]
  documents          PublicPostDocument[]
  externalLinks      ExternalLinkSubmission[]
  privateConversations PrivateConversation[]
  comments           PublicComment[]
  reviews            PublicReview[]

  @@index([type, visibility, createdAt])
  @@index([status, moderationStatus, createdAt])
  @@index([authorUserId, createdAt])
  @@index([authorProfileId, createdAt])
  @@index([countryId, regionId, cityId])
}

model PublicPostMedia {
  id         String                @id @default(uuid())
  postId     String
  url        String
  type       PublicPostMediaType
  role       String                @default("GALLERY")
  alt        String?
  status     PublicModerationStatus @default(PENDING)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  post       PublicPost            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status, createdAt])
}

model PublicPostDocument {
  id               String                @id @default(uuid())
  postId           String
  title            String
  description      String?
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageProvider  String
  storageBucket    String?
  storageKey       String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  post             PublicPost            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model ExternalLinkSubmission {
  id             String                   @id @default(uuid())
  url            String
  normalizedUrl  String
  sourcePostId   String
  submittedBy    String
  securityStatus ExternalLinkSecurityStatus @default(PENDING)
  reasonsJson    Json
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  sourcePost     PublicPost               @relation(fields: [sourcePostId], references: [id], onDelete: Cascade)

  @@index([sourcePostId, createdAt])
  @@index([securityStatus, createdAt])
}

model PrivateConversation {
  id             String                    @id @default(uuid())
  postId         String
  requesterName  String
  ownerName      String
  status         PrivateConversationStatus @default(OPEN)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  post           PublicPost                @relation(fields: [postId], references: [id], onDelete: Cascade)
  messages       PrivateMessage[]

  @@index([postId, createdAt])
  @@index([status, createdAt])
}

model PrivateMessage {
  id             String                @id @default(uuid())
  conversationId String
  senderName     String
  message        String
  status         PrivateMessageStatus  @default(SENT)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  conversation   PrivateConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model PublicComment {
  id         String                @id @default(uuid())
  postId     String
  authorName String
  comment    String
  status     PublicCommentStatus   @default(PENDING_REVIEW)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  post       PublicPost            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([status, createdAt])
}

model PublicReview {
  id         String                @id @default(uuid())
  postId     String
  authorName String
  rating     Int?
  review     String
  status     PublicReviewStatus    @default(PENDING_REVIEW)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  post       PublicPost            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([status, createdAt])
}

model Project {
  id                      String                  @id @default(uuid())
  slug                    String                  @unique
  name                    String
  summary                 String?
  description             String?
  scopeOfWork             String?
  engagementModel         ProjectEngagementModel
  status                  ProjectStatus           @default(DRAFT)
  visibility              ProjectVisibility       @default(PRIVATE)
  location                String?
  addressLine1            String?
  addressLine2            String?
  postalCode              String?
  latitude                Float?
  longitude               Float?
  countryId               String?
  regionId                String?
  cityId                  String?
  primaryLanguageId       String?
  budgetMinCents          Int?
  budgetMaxCents          Int?
  currencyCode            String?
  startDate               DateTime?
  endDate                 DateTime?
  responseDeadline        DateTime?
  publishedAt             DateTime?
  archivedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  createdById             String

  createdBy               User                    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  country                 Country?                @relation(fields: [countryId], references: [id])
  region                  Region?                 @relation(fields: [regionId], references: [id])
  city                    City?                   @relation(fields: [cityId], references: [id])
  primaryLanguage         Language?               @relation(fields: [primaryLanguageId], references: [id])
  jobRequests             ProjectJobRequest[]
  conditions              ProjectCondition[]
  documents               ProjectDocument[]
  aiInterpretation        ProjectAIInterpretation?
  escoClassifications     ProjectEscoClassification[]
  naceClassifications     ProjectNaceClassification[]
  uniclassClassifications ProjectUniclassClassification[]
  shortlists              ProjectShortlist[]
  invitations             ProjectInvitation[]
  proposals               ProjectProposal[]
  contracts               ProjectContract[]
  escrowAccounts          ProjectEscrowAccount[]
  milestones              ProjectMilestone[]
  invoices                ProjectInvoice[]
  payments                ProjectPayment[]
  disputes                ProjectDispute[]
  contractFinancialSnapshots ContractFinancialSnapshot[]
  complianceAlerts        ComplianceAlert[]
  userTasks               UserTask[]
  auditLogs               AuditLog[]
  workerAssignments       ProjectWorkerAssignment[]
  workerAttendances       WorkerAttendance[]
  workerWorkLogs          WorkerWorkLog[]
  workerTimesheets        WorkerTimesheet[]
  workerPayrollCalculations WorkerPayrollCalculation[]
  conversations          Conversation[]

  @@index([createdById, createdAt])
  @@index([status, engagementModel])
  @@index([countryId, regionId, cityId])
}

model ProjectJobRequest {
  id                      String                               @id @default(uuid())
  projectId               String
  title                   String
  description             String?
  scopeOfWork             String?
  status                  ProjectJobRequestStatus              @default(DRAFT)
  workerCount             Int?
  unit                    String?
  budgetMinCents          Int?
  budgetMaxCents          Int?
  currencyCode            String?
  requiredExperienceYears Int?
  requiresCertification   Boolean                              @default(false)
  startDate               DateTime?
  endDate                 DateTime?
  responseDeadline        DateTime?
  languageId              String?
  notes                   String?
  createdAt               DateTime                             @default(now())
  updatedAt               DateTime                             @updatedAt

  project                 Project                              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language                Language?                            @relation(fields: [languageId], references: [id])
  conditions              ProjectCondition[]
  documents               ProjectDocument[]
  escoClassifications     ProjectJobRequestEscoClassification[]
  naceClassifications     ProjectJobRequestNaceClassification[]
  uniclassClassifications ProjectJobRequestUniclassClassification[]
  workerAssignments       ProjectWorkerAssignment[]
  workerAttendances       WorkerAttendance[]
  workerWorkLogs          WorkerWorkLog[]

  @@index([projectId, status])
  @@index([languageId])
}

model ProjectCondition {
  id           String                @id @default(uuid())
  projectId    String
  jobRequestId String?
  type         ProjectConditionType
  scope        ProjectConditionScope @default(PROJECT)
  title        String
  clauseKey    String?
  content      String
  isMandatory  Boolean               @default(true)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobRequest   ProjectJobRequest?    @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@index([projectId, scope, sortOrder])
  @@index([jobRequestId])
}

model ProjectAIInterpretation {
  id              String                        @id @default(uuid())
  projectId       String                        @unique
  status          ProjectAIInterpretationStatus @default(PENDING)
  sourceText      String?
  extractedJson   String?
  documentIds     String?
  confidenceScore Float?
  modelName       String?
  modelVersion    String?
  promptVersion   String?
  reviewedById    String?
  reviewNotes     String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  project         Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy      User?                         @relation("ProjectAIReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([reviewedById])
}

model ProjectDocument {
  id               String             @id @default(uuid())
  projectId        String
  jobRequestId     String?
  uploadedById     String?
  type             ProjectDocumentType
  title            String
  description      String?
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageProvider  String
  storageBucket    String?
  storageKey       String
  checksumSha256   String?
  extractedText    String?
  extractionStatus String             @default("NOT_REQUESTED")
  extractionError  String?
  extractedAt      DateTime?
  isPublic         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobRequest       ProjectJobRequest? @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  uploadedBy       User?              @relation("ProjectDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([projectId, type])
  @@index([jobRequestId])
  @@index([uploadedById])
}

model Profile {
  id                         String                            @id @default(uuid())
  userId                     String                            @unique
  slug                       String                            @unique
  profileType                ProfileType
  displayName                String
  companyName                String?
  publicHeadline             String?
  description                String?
  summary                    String?
  websiteUrl                 String?
  publicEmail                String?
  publicPhone                String?
  privateEmail               String?
  privatePhone               String?
  privateNotes               String?
  companyRegistrationNumber  String?
  taxNumber                  String?
  visibility                 ProfileVisibility                 @default(PRIVATE)
  moderationStatus           ProfileModerationStatus           @default(PENDING)
  status                     ProfileLifecycleStatus            @default(OFFLINE)
  logoUrl                    String?
  photoUrl                   String?
  bannerUrl                  String?
  cvUrl                      String?
  portfolioUrlsJson          String?
  approvalNotes              String?
  approvedAt                 DateTime?
  countryId                  String?
  regionId                   String?
  cityId                     String?
  supportedEngagementModels  String?
  certificationsText         String?
  availabilityStatus         ProfileAvailabilityStatus         @default(AVAILABLE)
  rating                     Float?
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt

  user                       User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  country                    Country?                          @relation(fields: [countryId], references: [id])
  region                     Region?                           @relation(fields: [regionId], references: [id])
  city                       City?                             @relation(fields: [cityId], references: [id])
  publicPosts                PublicPost[]
  contractorProfile          ContractorProfile?
  professionalProfile        ProfessionalProfile?
  languages                  ProfileLanguage[]
  documents                  ProfileDocument[]
  escoClassifications        ProfileEscoClassification[]
  naceClassifications        ProfileNaceClassification[]
  uniclassClassifications    ProfileUniclassClassification[]
  shortlists                 ProjectShortlist[]
  invitations                ProjectInvitation[]
  proposals                  ProjectProposal[]
  contracts                  ProjectContract[]
  invoices                   ProjectInvoice[]
  payments                   ProjectPayment[]
  disputesAgainst            ProjectDispute[]         @relation("ProjectDisputeAgainstProfile")
  contractFinancialSnapshots ContractFinancialSnapshot[]
  actorDocuments             ActorDocument[]
  actorCertifications        ActorCertification[]
  medicalFitnessCertificates MedicalFitnessCertificate[] @relation("MedicalFitnessProfile")
  issuedMedicalFitnessCertificates MedicalFitnessCertificate[] @relation("MedicalFitnessIssuedByProfile")
  complianceAlerts           ComplianceAlert[]
  userTasks                  UserTask[]
  notifications              Notification[]
  workers                    ProfileWorker[]
  workerAssignments          ProjectWorkerAssignment[]
  workerTimesheets           WorkerTimesheet[]
  workerPayrollCalculations  WorkerPayrollCalculation[]

  @@index([profileType])
  @@index([countryId, regionId, cityId])
  @@index([availabilityStatus])
  @@index([visibility, moderationStatus, status])
}

model ContractorProfile {
  id          String   @id @default(uuid())
  profileId   String   @unique
  tradeFocus  String?
  teamSize    Int?
  serviceArea String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalProfile {
  id             String   @id @default(uuid())
  profileId      String   @unique
  headline       String?
  yearsExperience Int?
  portfolioFocus String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfileLanguage {
  profileId   String
  languageId  String
  createdAt   DateTime @default(now())

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language    Language  @relation(fields: [languageId], references: [id])

  @@id([profileId, languageId])
  @@index([languageId])
}

model ProfileDocument {
  id               String                @id @default(uuid())
  profileId        String
  uploadedById     String?
  type             ProfileDocumentType
  assetKind        ProfileAssetKind?
  title            String
  description      String?
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageProvider  String
  storageBucket    String?
  storageKey       String
  checksumSha256   String?
  extractedText    String?
  extractionStatus String                @default("NOT_REQUESTED")
  extractionError  String?
  extractedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  profile          Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  uploadedBy       User?                 @relation("ProfileDocumentUploadedBy", fields: [uploadedById], references: [id])
  actorDocuments   ActorDocument[]

  @@index([profileId, type])
  @@index([uploadedById])
}

model ProjectShortlist {
  id          String   @id @default(uuid())
  projectId   String
  profileId   String
  createdById String
  matchScore  Int?
  notes       String?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("ProjectShortlistCreatedBy", fields: [createdById], references: [id])

  @@unique([projectId, profileId])
  @@index([projectId, createdAt])
  @@index([profileId, createdAt])
  @@index([createdById])
}

model ProjectInvitation {
  id          String                  @id @default(uuid())
  projectId   String
  profileId   String
  createdById String
  status      ProjectInvitationStatus @default(DRAFT)
  message     String?
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime                @default(now())

  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile     Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy   User                    @relation("ProjectInvitationCreatedBy", fields: [createdById], references: [id])
  proposals   ProjectProposal[]

  @@unique([projectId, profileId])
  @@index([projectId, status, createdAt])
  @@index([profileId, status, createdAt])
  @@index([createdById])
}

model ProjectProposal {
  id                 String                @id @default(uuid())
  projectId          String
  profileId          String
  invitationId       String?
  submittedById      String
  status             ProjectProposalStatus @default(DRAFT)
  title              String
  message            String?
  priceCents         Int?
  currencyCode       String?
  estimatedStartDate DateTime?
  estimatedEndDate   DateTime?
  terms              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile            Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  invitation         ProjectInvitation?    @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  submittedBy        User                  @relation("ProjectProposalSubmittedBy", fields: [submittedById], references: [id])
  contracts          ProjectContract[]

  @@unique([projectId, profileId])
  @@index([projectId, status, updatedAt])
  @@index([profileId, status, updatedAt])
  @@index([submittedById])
  @@index([invitationId])
}

model ProjectContract {
  id              String               @id @default(uuid())
  projectId       String
  proposalId      String
  profileId       String
  createdById     String
  status          ProjectContractStatus @default(DRAFT)
  contractType    ProjectEngagementModel
  title           String
  scopeSummary    String?
  commercialTerms String?
  paymentTerms    String?
