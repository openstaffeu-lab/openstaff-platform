  signedAt        DateTime?
  startDate       DateTime?
  endDate         DateTime?

  disputes        Dispute[]

  @@index([jobId, status, createdAt])
  @@index([employerId, status, createdAt])
  @@index([contractorId, status, createdAt])
}

