model ComplianceAlert {
  id                         String               @id @default(uuid())
  key                        String               @unique
  userId                     String
  profileId                  String?
  projectId                  String?
  contractId                 String?
  actorDocumentId            String?
  actorCertificationId       String?
  medicalFitnessCertificateId String?
  type                       ComplianceAlertType
  severity                   ComplianceAlertSeverity
  message                    String
  dueDate                    DateTime?
  status                     ComplianceAlertStatus @default(PENDING)
  createdAt                  DateTime             @default(now())
  sentAt                     DateTime?
  readAt                     DateTime?
  resolvedAt                 DateTime?

  user                       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile                    Profile?             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  project                    Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract                   ProjectContract?     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  actorDocument              ActorDocument?       @relation(fields: [actorDocumentId], references: [id], onDelete: Cascade)
  actorCertification         ActorCertification?  @relation(fields: [actorCertificationId], references: [id], onDelete: Cascade)
  medicalFitnessCertificate  MedicalFitnessCertificate? @relation(fields: [medicalFitnessCertificateId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([profileId, status])
  @@index([projectId, status])
  @@index([contractId, status])
  @@index([dueDate, status])
}

model UserTask {
  id                         String               @id @default(uuid())
  key                        String               @unique
  assignedToUserId           String
  projectId                  String?
  contractId                 String?
  profileId                  String?
  actorDocumentId            String?
  actorCertificationId       String?
  medicalFitnessCertificateId String?
  type                       UserTaskType
  title                      String
  description                String?
  status                     UserTaskStatus       @default(OPEN)
  priority                   UserTaskPriority     @default(MEDIUM)
  dueDate                    DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  completedAt                DateTime?

  assignedTo                 User                 @relation("UserTaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  project                    Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract                   ProjectContract?     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  profile                    Profile?             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  actorDocument              ActorDocument?       @relation(fields: [actorDocumentId], references: [id], onDelete: Cascade)
  actorCertification         ActorCertification?  @relation(fields: [actorCertificationId], references: [id], onDelete: Cascade)
  medicalFitnessCertificate  MedicalFitnessCertificate? @relation(fields: [medicalFitnessCertificateId], references: [id], onDelete: Cascade)

  @@index([assignedToUserId, status, dueDate])
  @@index([projectId, status])
  @@index([contractId, status])
  @@index([profileId, status])
}

model AuditLog {
