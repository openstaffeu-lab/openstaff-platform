  relatedEntityType String?
  relatedEntityId   String?
  scheduledFor      DateTime?
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile           Profile?          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  actor             Actor?            @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([profileId, status, createdAt])
  @@index([actorId, status, createdAt])
  @@index([scheduledFor, status])
}

model Conversation {
  id           String                      @id @default(uuid())
  projectId    String?
  contractId   String?
  disputeId    String?
  type         ConversationType
  createdAt    DateTime                    @default(now())

  project      Project?                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract     ProjectContract?            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  dispute      ProjectDispute?             @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([projectId, type, createdAt])
  @@index([contractId, type, createdAt])
  @@index([disputeId, type, createdAt])
}

model ConversationParticipant {
  id             String                      @id @default(uuid())
  conversationId String
  userId         String
  role           ConversationParticipantRole
  joinedAt       DateTime                    @default(now())

  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType
  content        String
  metadataJson   String?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reads          MessageRead[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model Actor {
  id                    String         @id @default(uuid())
